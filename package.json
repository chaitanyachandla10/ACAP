{
  "name": "acap-workforce",
  "version": "2.0.0",
  "private": true,
  "description": "Workforce planning and department allocation platform",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:api": "node server.js",
    "dev:api": "nodemon server.js",
    "start:all": "concurrently -n API,WEB -c cyan,magenta \"npm run dev:api\" \"npm start\"",
    "build": "ng build --configuration production",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@angular/router": "^20.3.0",
    "cors": "^2.8.6",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "rxjs": "^7.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "^5.1.4",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.0",
    "jasmine-core": "^6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "nodemon": "^3.1.10",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19 <25"
  }
}
